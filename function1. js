const computeExpression = function(number1, number2, number3,number4, number5, number6){
    return ((number1 * number2) - (number3 * number4)) / (number5 - number6);
}
console.log(computeExpression(9.5, 4.5, 2.5, 3, 45.5, 3.5));



function summationOfASeries(numbers) {
  let total = 0;
  for (let i = 0; i < numbers.length; i++) {
    total += numbers[i];
  }
  return total;
}

console.log(summationOfASeries([1, 2, 3, 4, 5, 6, 7, 8, 9]));



